" vim: ft=vim

set adblocker=off
set devtoolsposition=vsplit
set notimeout
set splitbelow
set splitright
set suggesttopsites=0
set tabclosefocus=right
set followlabelposition=insidetopleft

set mouse=all

set containercolors={"me":"lightcoral","work":"lightblue","university":"lightgreen"}

command! tabonly <:rclose><:lclose>
command! zoomin <zoomIn>
command! zoomout <zoomOut>
command! zoomreset <zoomReset>

colorscheme brittle-hollow

mapclear!

map <M-q> <:quitall>

nmap <CR> <toInsertMode>
map <Esc> <toNormalMode>
nmap <Esc> <:nohlsearch>

nmap : <toCommandMode>
nmap ; <toCommandMode>
nmap s <toCommandMode>set<Space>

nmap r <refreshTab>
nmap R <refreshTabWithoutCache>
nmap wd <:devtools>

nmap H <previousTab>
nmap J <nextTab>
nmap K <previousTab>
nmap L <nextTab>

nmap th <moveTabBackward>
nmap tj <moveTabForward>
nmap tk <moveTabBackward>
nmap tl <moveTabForward>
nmap to <:tabonly>

nmap ws <:split>
nmap wv <:vsplit>
nmap wh <toLeftSplitWindow>
nmap wj <toBottomSplitWindow>
nmap wk <toTopSplitWindow>
nmap wl <toRightSplitWindow>
nmap wH <leftHalfSplitWindow>
nmap wJ <bottomHalfSplitWindow>
nmap wK <topHalfSplitWindow>
nmap wL <rightHalfSplitWindow>
nmap wr <rotateSplitWindowForward>
nmap wR <rotateSplitWindowBackward>

nmap o <toExploreMode><BS>
nmap e <toExploreMode><Right>
nmap O <:tabnew><toExploreMode>
nmap x <:close>
nmap u <reopenTab>

nmap f <toCommandMode>b<Space>

nmap h <scrollLeft>
nmap j <scrollDown>
nmap k <scrollUp>
nmap l <scrollRight>
nmap g <scrollTop>
nmap G <scrollBottom>
map <C-d> <scrollPageDownHalf>
map <C-u> <scrollPageUpHalf>
nmap = <:zoomin>
nmap + <:zoomin>
nmap - <:zoomout>
nmap _ <:zoomout>

nmap / <toSearchMode><BS>
nmap n <nextSearchMatch>
nmap N <previousSearchMatch>
imap <C-n> <nextSearchMatch>
imap <C-N> <previousSearchMatch>

nmap yy <pageToClipboard>
nmap yt <pageTitleToClipboard>
nmap ys <:screencopy>

nmap cm <:set containernewtab=me><:tabnew><:set containernewtab=s:usecurrent><toExploreMode>
nmap cw <:set containernewtab=work><:tabnew><:set containernewtab=s:usecurrent><toExploreMode>
nmap cu <:set containernewtab=university><:tabnew><:set containernewtab=s:usecurrent><toExploreMode>

imap <M-f> <toSearchMode>
imap <C-k> <backInHistory>
nmap <C-k> <backInHistory>
imap <C-j> <forwardInHistory>
nmap <C-j> <forwardInHistory>

smap <CR> <useEnteredData>
emap <CR> <useEnteredData>
cmap <CR> <useEnteredData>

cmap <Up> <commandHistoryPrevious>
cmap <Down> <commandHistoryNext>
cmap <C-n> <nextSuggestion>
cmap <C-N> <prevSuggestion>
emap <C-n> <nextSuggestion>
emap <C-N> <prevSuggestion>

nmap a <:set followelement=url><startFollowCurrentTab>
nmap b <:set followelement=onclick><startFollowCurrentTab>
nmap i <:set followelement=inputs-insert><startFollowCurrentTab>
nmap p <:set followelement=image><startFollowCurrentTab>

nmap v <pointer.centerOfView><pointer.start>

pmap h <pointer.moveLeft>
pmap j <pointer.moveDown>
pmap k <pointer.moveUp>
pmap l <pointer.moveRight>

pmap <C-h> <pointer.moveFastLeft>
pmap <C-j> <pointer.moveFastDown>
pmap <C-k> <pointer.moveFastUp>
pmap <C-l> <pointer.moveFastRight>
pmap <C-d> 2<scrollDown>
pmap <C-u> 2<scrollUp>

pmap a <:set followelementpointer=url><startFollowCurrentTab>
pmap b <:set followelementpointer=onclick><startFollowCurrentTab>
pmap i <:set followelementpointer=inputs-insert><startFollowCurrentTab>
pmap p <:set followelementpointer=image><startFollowCurrentTab>

pmap <CR> <pointer.insertAtPosition>
pmap c <pointer.leftClick>
pmap C <pointer.rightClick>
pmap d <pointer.downloadLink>
pmap t <pointer.newtabLink>
pmap P <pointer.newtabImage>
pmap yy <pointer.copyText>
pmap ya <pointer.copyLink>
pmap yp <pointer.copyImageBuffer>
pmap D <pointer.inspectElement>

pmap v <pointer.startVisualSelect>
vmap h <pointer.moveLeft>
vmap j <pointer.moveDown>
vmap k <pointer.moveUp>
vmap l <pointer.moveRight>
vmap o <pointer.swapPosition>
vmap y <pointer.copyText><toNormalMode>
